# Supabase - placeholder, non inserire chiavi reali qui
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe - solo strutture ricettive
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_PRICE_SMALL=price_small_placeholder
STRIPE_PRICE_MEDIUM=price_medium_placeholder
STRIPE_PRICE_LARGE=price_large_placeholder

# Email (Resend + mittente transazionale)
RESEND_API_KEY=re_placeholder
NOTIFICATION_EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
# Alert operativi admin (registrazioni, annunci, offerte, rivendiche)
ADMIN_NOTIFY_EMAIL=info@hotelsdrop.com
# La conferma account registrazione usa Resend (info@hotelsdrop.com) quando
# RESEND_API_KEY e SUPABASE_SERVICE_ROLE_KEY sono configurati.
# Alias legacy supportati dal codice:
# EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
# AUTH_EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
#
# Reset password / altre email Supabase Auth: configurare SMTP Resend
# nel dashboard Supabase con sender info@hotelsdrop.com.

# App — in produzione: https://hotelsdrop.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# Foursquare Places (server-side only — destination slider focus mode)
FOURSQUARE_API_KEY=

# Google Places API (onboarding hotel scraping)
GOOGLE_PLACES_API_KEY=
# Optional one-off harvest: pass on CLI so .env.local key is not billed for search
# GOOGLE_PLACES_API_KEY_TEMP=
# GOOGLE_PLACES_PHOTOS_KEY=

# Gemini API (descrizioni SEO automatiche — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_DELAY_MS=400

# LM Studio (locale — OpenAI-compatible server)
# LMSTUDIO_BASE_URL=http://192.168.1.6:1234/v1
# LMSTUDIO_MODEL=qwen2.5-7b-instruct-uncensored
# LMSTUDIO_API_KEY=   # obbligatorio se "Require Authentication" è ON

# Claim token signing secret (onboarding magic link)
CLAIM_TOKEN_SECRET=

# Cron Vercel — purge richieste/offerte scadute (Bearer o ?secret=)
CRON_SECRET=generate-a-long-random-secret

# IndexNow (Bing, Yandex, Naver, ecc.) — chiave = nome file in public/{key}.txt
INDEXNOW_API_KEY=6cfc69986d924392bf34861a5187da1d
# Opzionale: override URL verifica (default https://www.hotelsdrop.com/{key}.txt)
# INDEXNOW_KEY_LOCATION=
