# Supabase - placeholder, non inserire chiavi reali qui
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe - solo strutture ricettive
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_PRICE_SMALL=price_small_placeholder
STRIPE_PRICE_MEDIUM=price_medium_placeholder
STRIPE_PRICE_LARGE=price_large_placeholder

# Email (Resend + mittente transazionale)
RESEND_API_KEY=re_placeholder
NOTIFICATION_EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
# Alias legacy supportati dal codice:
# EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
# AUTH_EMAIL_FROM="HotelsDrop.com <info@hotelsdrop.com>"
#
# Conferma profilo registrazione (Supabase Auth SMTP, dashboard Supabase):
# imposta Sender email = info@hotelsdrop.com (non usare Gmail personale).

# App — in produzione: https://hotelsdrop.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# Foursquare Places (server-side only — destination slider focus mode)
FOURSQUARE_API_KEY=

# Google Places API (onboarding hotel scraping)
GOOGLE_PLACES_API_KEY=
# Optional one-off harvest: pass on CLI so .env.local key is not billed for search
# GOOGLE_PLACES_API_KEY_TEMP=
# GOOGLE_PLACES_PHOTOS_KEY=

# Claim token signing secret (onboarding magic link)
CLAIM_TOKEN_SECRET=
